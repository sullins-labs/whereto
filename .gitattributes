# Shell scripts must stay LF. Checked out with CRLF on Windows they fail on
# Linux with "bad interpreter: /usr/bin/env sh^M", which would break the sync
# script the moment it ran anywhere other than Git Bash.
*.sh text eol=lf

# The built dataset is generated by json.dumps and read by the browser. Keep
# it byte-stable so a diff reflects a data change and nothing else.
*.json -text
